# 只填写域名，不带 https://。DNS 的 A/AAAA 记录必须先指向部署服务器。
APP_DOMAIN=studio.example.com
APP_IMAGE=molimama-web:1.2.9

PUBLIC_PLATFORM_MODE=true
PLATFORM_REGISTRATION_ENABLED=false
PLATFORM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# 分别生成不少于 32 字符的随机值，两个值不得相同。
PLATFORM_JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARS
PLATFORM_ADMIN_TOKEN=CHANGE_ME_GENERATE_A_DIFFERENT_TOKEN_AT_LEAST_32_CHARS

DATA_BACKUP_RETENTION=6
DATA_BACKUP_MIN_FREE_BYTES=10737418240
