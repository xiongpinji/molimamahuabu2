# 只填写域名，不带 https://。DNS 的 A/AAAA 记录必须先指向部署服务器。
APP_DOMAIN=studio.example.com
APP_IMAGE=ghcr.io/xiongpinji/molimamahuabu2:sha-<commit-sha>

PUBLIC_PLATFORM_MODE=true
PLATFORM_REGISTRATION_ENABLED=false
PLATFORM_EMAIL_VERIFICATION_ENABLED=true
PLATFORM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# 分别生成不少于 32 字符的随机值，三个值不得相同。
PLATFORM_JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARS
PLATFORM_ADMIN_TOKEN=CHANGE_ME_GENERATE_A_DIFFERENT_TOKEN_AT_LEAST_32_CHARS
REDRAW_PROVIDER_ASSET_HMAC_SECRET=CHANGE_ME_GENERATE_A_THIRD_SECRET_AT_LEAST_32_CHARS

# 开放注册前必须填写真实 SMTP。465 通常配合 SMTP_SECURE=true，587 通常为 false。
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD
SMTP_FROM=茉莉妈妈短剧制作平台 <no-reply@example.com>

DATA_BACKUP_RETENTION=6
DATA_BACKUP_MIN_FREE_BYTES=10737418240

# 生产镜像已内置经许可证与哈希审计的 rembg 2.0.77 CPU 运行时和 u2netp。
# 默认保持全局与单租户各 1 个并发，轻量服务器不要调高。
IMAGE_TOOL_REMBG_MAX_CONCURRENCY=1
IMAGE_TOOL_REMBG_MAX_TENANT_CONCURRENCY=1

# 独立画布真实模型（仅服务端读取；不要使用 VITE_ 前缀）
CANVAS_TEXT_BASE_URL=https://rehdasu.cn/v1
CANVAS_TEXT_API_KEY=
CANVAS_TEXT_MODEL=gpt-5.6-sol
CANVAS_IMAGE_BASE_URL=https://aihubcc.cc/v1
CANVAS_IMAGE_API_KEY=
CANVAS_IMAGE_MODEL=gpt-image-2-2k
CANVAS_VIDEO_BASE_URL=https://seed.alimyun.xyz/api/open/v1
CANVAS_VIDEO_API_KEY=
CANVAS_VIDEO_MODEL=lingjing-video-v1

# 300 人在线容量保护：普通请求上限与各类模型调用并发/排队上限
SERVER_MAX_CONNECTIONS=1024
GENERATION_TEXT_CONCURRENCY=12
GENERATION_IMAGE_CONCURRENCY=8
GENERATION_VIDEO_CONCURRENCY=6
GENERATION_MAX_QUEUE_SIZE=300
HTTP_REQUEST_LOGGING=false
